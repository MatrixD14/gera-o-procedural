//C-R:chunkgen
class chunkgen extends Component { //[I-S]LN=0;[I-E]
  public class object { //[I-S]LN=1;[I-E]
    public SpatialObject TerrCriate(float posx, float posy) { //[I-S]LN=2;[I-E]
      SpatialObject Obj = new SpatialObject("chuck " + posx + posy); //[I-S]LN=3;[I-E]
      Obj.setStatic(true); //[I-S]LN=4;[I-E]
      Obj.addComponent(new ModelRenderer()); //[I-S]LN=5;[I-E]
      Obj.addComponent(new TerreController()); //[I-S]LN=6;[I-E]
      Obj.setPosition(posx, 0, posy); //[I-S]LN=7;[I-E]
      Obj.removeComponent(new TerreController()); //[I-S]LN=8;[I-E]
      return Obj; //[I-S]LN=9;[I-E]
    } //[I-S]LN=10;[I-E]
  } //[I-S]LN=11;[I-E]
 //[I-S]LN=12;[I-E]
  @Hide public float waterlevel = .5f; //[I-S]LN=13;[I-E]
  @Hide public int chunks = 4, width = 16, seed; //[I-S]LN=14;[I-E]
  public float scale, heightscale, valuelog; //[I-S]LN=15;[I-E]
  public MaterialFile TerrMate, WaterMate; //[I-S]LN=16;[I-E]
  @Hide public chunkgen.object object; //[I-S]LN=17;[I-E]
  public List<ObjectFile> trees = new ArrayList<ObjectFile>(); //[I-S]LN=18;[I-E]
  private Vector3 myposGlobal; //[I-S]LN=19;[I-E]
  private int lastChuckX = Integer.MIN_VALUE, lastChuckZ = Integer.MIN_VALUE; //[I-S]LN=20;[I-E]
  private int myposxs, myposzs; //[I-S]LN=21;[I-E]
  public HashMap<Long, SpatialObject> chunck = new HashMap<Long, SpatialObject>(); //[I-S]LN=22;[I-E]
  public Queue<Long> process = new ArrayDeque<Long>(); //[I-S]LN=23;[I-E]
 //[I-S]LN=24;[I-E]
  @Override //[I-S]LN=25;[I-E]
public   void start() { //[I-S]LN=26;[I-E]
    object = new chunkgen.object(); //[I-S]LN=27;[I-E]
    seed = Random.range(0, 500); //[I-S]LN=28;[I-E]
  } //[I-S]LN=29;[I-E]
 //[I-S]LN=30;[I-E]
  @Override //[I-S]LN=31;[I-E]
public   void repeat() { //[I-S]LN=32;[I-E]
    posplayermy(); //[I-S]LN=33;[I-E]
    spawobjT(); //[I-S]LN=34;[I-E]
    processaChuck(1); //[I-S]LN=35;[I-E]
    removeChunck(); //[I-S]LN=36;[I-E]
  } //[I-S]LN=37;[I-E]
 //[I-S]LN=38;[I-E]
  private void posplayermy() { //[I-S]LN=39;[I-E]
    myposGlobal = myObject.getGlobalPosition(); //[I-S]LN=40;[I-E]
myposxs = (int) Math.floor(myposGlobal.getX() / width); //[I-S]LN=41;[I-E]
myposzs = (int) Math.floor(myposGlobal.getZ() / width); //[I-S]LN=42;[I-E]
  } //[I-S]LN=43;[I-E]
 //[I-S]LN=44;[I-E]
  private void spawobjT() { //[I-S]LN=45;[I-E]
    if (myposxs == lastChuckX && myposzs == lastChuckZ) return; //[I-S]LN=46;[I-E]
    lastChuckX = myposxs; //[I-S]LN=47;[I-E]
    lastChuckZ = myposzs; //[I-S]LN=48;[I-E]
    for (int x = (-chunks); x < (chunks); x++) { //[I-S]LN=49;[I-E]
      for (int z = (-chunks); z < (chunks); z++) { //[I-S]LN=50;[I-E]
        int px = x + myposxs; //[I-S]LN=51;[I-E]
        int pz = z + myposzs; //[I-S]LN=52;[I-E]
        long poskey = CodificKey(px, pz); //[I-S]LN=53;[I-E]
        if (chunck.containsKey(poskey)) continue; //[I-S]LN=54;[I-E]
        process.add(poskey); //[I-S]LN=55;[I-E]
      } //[I-S]LN=56;[I-E]
    } //[I-S]LN=57;[I-E]
  } //[I-S]LN=58;[I-E]
 //[I-S]LN=59;[I-E]
  private void processaChuck(int quant) { //[I-S]LN=60;[I-E]
    if (process.isEmpty()) return; //[I-S]LN=61;[I-E]
    for (int i = 0; i < quant; i++) { //[I-S]LN=62;[I-E]
      long poss = process.remove(); //[I-S]LN=63;[I-E]
      int px = (int) DescodificKeyX(poss); //[I-S]LN=64;[I-E]
      int pz = (int) DescodificKeyZ(poss); //[I-S]LN=65;[I-E]
      long poskey = CodificKey(px, pz); //[I-S]LN=66;[I-E]
      if (chunck.containsKey(poskey)) continue; //[I-S]LN=67;[I-E]
      SpatialObject TerrObj = object.TerrCriate(px * width, pz * width); //[I-S]LN=68;[I-E]
      if (TerrObj != null && TerrObj.exists()) chunck.put(poskey, TerrObj); //[I-S]LN=69;[I-E]
    } //[I-S]LN=70;[I-E]
  }  //[I-S]LN=71;[I-E]
 //[I-S]LN=72;[I-E]
  private void removeChunck() { //[I-S]LN=73;[I-E]
    Iterator<Map.Entry<Long, SpatialObject>> item = chunck.entrySet().iterator(); //[I-S]LN=74;[I-E]
    while (item.hasNext()) { //[I-S]LN=75;[I-E]
      Map.Entry<Long, SpatialObject> entregrar = item.next(); //[I-S]LN=76;[I-E]
      int posChunckX = DescodificKeyX(entregrar.getKey()); //[I-S]LN=77;[I-E]
      int posChunckZ = DescodificKeyZ(entregrar.getKey()); //[I-S]LN=78;[I-E]
      int dX = Math.abs(posChunckX - myposxs); //[I-S]LN=79;[I-E]
      int dZ = Math.abs(posChunckZ - myposzs); //[I-S]LN=80;[I-E]
      if (dX > (chunks) || dZ > (chunks)) { //[I-S]LN=81;[I-E]
        entregrar.getValue().destroy(); //[I-S]LN=82;[I-E]
        item.remove(); //[I-S]LN=83;[I-E]
      } //[I-S]LN=84;[I-E]
    } //[I-S]LN=85;[I-E]
  } //[I-S]LN=86;[I-E]
 //[I-S]LN=87;[I-E]
  public long CodificKey(int x, int z) { //[I-S]LN=88;[I-E]
    return (((long) x) << 32) | (z & 0xFFFFFFFFL); //[I-S]LN=89;[I-E]
  } //[I-S]LN=90;[I-E]
 //[I-S]LN=91;[I-E]
  public int DescodificKeyX(long x) { //[I-S]LN=92;[I-E]
    return (int) (x >> 32); //[I-S]LN=93;[I-E]
  } //[I-S]LN=94;[I-E]
 //[I-S]LN=95;[I-E]
  public int DescodificKeyZ(long z) { //[I-S]LN=96;[I-E]
    return (int) z; //[I-S]LN=97;[I-E]
  } //[I-S]LN=98;[I-E]
} //[I-S]LN=99;[I-E]
//C-R:TerreController
class TerreController extends Component { //[I-S]LN=0;[I-E]
  private SpatialObject armLog, Obj, voi; //[I-S]LN=1;[I-E]
  private ModelRenderer TerrModelo; //[I-S]LN=2;[I-E]
  private Vertex TerrVertex; //[I-S]LN=3;[I-E]
  private List<Vector3> TerrVertices = new LinkedList<Vector3>(), TerrNormal = new LinkedList<Vector3>(); //[I-S]LN=4;[I-E]
  private List<Vector2> TerrUV = new LinkedList<Vector2>(); //[I-S]LN=5;[I-E]
  private int[] TerrTriangle; //[I-S]LN=6;[I-E]
  private PerlinNoise perlin = new PerlinNoise(100); //[I-S]LN=7;[I-E]
  private chunkgen tama; //[I-S]LN=8;[I-E]
  private Vector3 mypos; //[I-S]LN=9;[I-E]
  private HashMap<Long, Float> HeightMap = new HashMap<Long, Float>(); //[I-S]LN=10;[I-E]
  private int[][] block = null; //[I-S]LN=11;[I-E]
  private malha modela = new malha(); //[I-S]LN=12;[I-E]
 //[I-S]LN=13;[I-E]
public   void start() { //[I-S]LN=14;[I-E]
    if (!myObject.exists()) return; //[I-S]LN=15;[I-E]
    tama = WorldController.findObject("player").findComponent("chunkgen"); //[I-S]LN=16;[I-E]
    armLog = WorldController.findObject("log"); //[I-S]LN=17;[I-E]
    TerrModelo = myObject.findComponent("modelrenderer"); //[I-S]LN=18;[I-E]
    reload(); //[I-S]LN=19;[I-E]
  } //[I-S]LN=20;[I-E]
 //[I-S]LN=21;[I-E]
  private void myposblock() { //[I-S]LN=22;[I-E]
mypos = myObject.getPosition(); //[I-S]LN=23;[I-E]
  } //[I-S]LN=24;[I-E]
 //[I-S]LN=25;[I-E]
  public void reload() { //[I-S]LN=26;[I-E]
    new AsyncTask( //[I-S]LN=27;[I-E]
        new AsyncRunnable() { //[I-S]LN=28;[I-E]
          public Object onBackground(Object input) { //[I-S]LN=29;[I-E]
            TerrVertex = new Vertex(); //[I-S]LN=30;[I-E]
            myposblock(); //[I-S]LN=31;[I-E]
            MatrizChunck(); //[I-S]LN=32;[I-E]
            HeightMap.clear(); //[I-S]LN=33;[I-E]
            TerrVertices.clear(); //[I-S]LN=34;[I-E]
            TerrNormal.clear(); //[I-S]LN=35;[I-E]
            TerrUV.clear(); //[I-S]LN=36;[I-E]
            return null; //[I-S]LN=37;[I-E]
          } //[I-S]LN=38;[I-E]
 //[I-S]LN=39;[I-E]
          public void onEngine(Object result) { //[I-S]LN=40;[I-E]
            WaterCriate(); //[I-S]LN=41;[I-E]
            generat(); //[I-S]LN=42;[I-E]
            if (Obj != null || Obj.exists()) { //[I-S]LN=43;[I-E]
              Water gera = Obj.findComponent("Water"); //[I-S]LN=44;[I-E]
              gera.WaterGera(); //[I-S]LN=45;[I-E]
            }  //[I-S]LN=46;[I-E]
          } //[I-S]LN=47;[I-E]
        }); //[I-S]LN=48;[I-E]
  } //[I-S]LN=49;[I-E]
 //[I-S]LN=50;[I-E]
  private void MatrizChunck() { //[I-S]LN=51;[I-E]
    block = new int[tama.width + 1][tama.width + 1]; //[I-S]LN=52;[I-E]
    for (int z = 0; z <= tama.width; z++) { //[I-S]LN=53;[I-E]
      for (int x = 0; x <= tama.width; x++) { //[I-S]LN=54;[I-E]
        float y = modela.perlinnoises(tama, myObject, x, z); //[I-S]LN=55;[I-E]
if (y + mypos.getY() >= tama.waterlevel - 2 && y + mypos.getY() <= 2 + tama.waterlevel) block[z][x] = 1; //[I-S]LN=56;[I-E]
else if (y + mypos.getY() >= tama.waterlevel - 8 && y + mypos.getY() <= tama.waterlevel - 2) block[z][x] = 4; //[I-S]LN=57;[I-E]
else if (y + mypos.getY() <= tama.waterlevel - 8) block[z][x] = 5; //[I-S]LN=58;[I-E]
        else block[z][x] = 3; //[I-S]LN=59;[I-E]
      } //[I-S]LN=60;[I-E]
    } //[I-S]LN=61;[I-E]
  } //[I-S]LN=62;[I-E]
 //[I-S]LN=63;[I-E]
  private void generat() { //[I-S]LN=64;[I-E]
    TerrTriangle = new int[tama.width * tama.width * 6]; //[I-S]LN=65;[I-E]
    for (int z = 0; z <= tama.width; z++) { //[I-S]LN=66;[I-E]
      for (int x = 0; x <= tama.width; x++) { //[I-S]LN=67;[I-E]
        float y = modela.perlinnoises(tama, myObject, x, z); //[I-S]LN=68;[I-E]
long codekey = CodificKey((int) (x + mypos.getX()), (int) (z + mypos.getZ())); //[I-S]LN=69;[I-E]
HeightMap.put(codekey, y + mypos.getY()); //[I-S]LN=70;[I-E]
        topFace(x, y, z, block[z][x]); //[I-S]LN=71;[I-E]
        generationlog(x, y, z); //[I-S]LN=72;[I-E]
      } //[I-S]LN=73;[I-E]
    } //[I-S]LN=74;[I-E]
    modela.triangulo(tama.width, TerrTriangle); //[I-S]LN=75;[I-E]
    TerrVertex = modela.meshup(false, TerrModelo, tama.TerrMate, TerrTriangle, TerrVertices, TerrNormal, TerrUV); //[I-S]LN=76;[I-E]
  } //[I-S]LN=77;[I-E]
 //[I-S]LN=78;[I-E]
  private void topFace(float x, float y, float z, int typeblock) { //[I-S]LN=79;[I-E]
    if (typeblock < 0) return; //[I-S]LN=80;[I-E]
    TerrVertices.add(new Vector3(x, y, z)); //[I-S]LN=81;[I-E]
    TerrNormal.add(new Vector3(0, 1, 0)); //[I-S]LN=82;[I-E]
    Vector2 uv = mapuv(typeblock); //[I-S]LN=83;[I-E]
TerrUV.add(new Vector2(uv.getX() / 2, uv.getY() / 2)); //[I-S]LN=84;[I-E]
  } //[I-S]LN=85;[I-E]
 //[I-S]LN=86;[I-E]
  private Vector2 mapuv(int type) { //[I-S]LN=87;[I-E]
    int t = 4; //[I-S]LN=88;[I-E]
    float tilasize = 1f / t; //[I-S]LN=89;[I-E]
    int tx = type % t; //[I-S]LN=90;[I-E]
    int tz = type / t; //[I-S]LN=91;[I-E]
    tz = (int) tilasize - 1 - tz; //[I-S]LN=92;[I-E]
    float u = tx * tilasize, v = tz * tilasize; //[I-S]LN=93;[I-E]
    return new Vector2(u, v); //[I-S]LN=94;[I-E]
  } //[I-S]LN=95;[I-E]
 //[I-S]LN=96;[I-E]
  public void WaterCriate() { //[I-S]LN=97;[I-E]
    Obj = new SpatialObject("Water"); //[I-S]LN=98;[I-E]
    Obj.setParent(myObject); //[I-S]LN=99;[I-E]
    Obj.setStatic(true); //[I-S]LN=100;[I-E]
    Obj.addComponent(new ModelRenderer()); //[I-S]LN=101;[I-E]
    Obj.addComponent(new Water()); //[I-S]LN=102;[I-E]
  } //[I-S]LN=103;[I-E]
 //[I-S]LN=104;[I-E]
  private void generationlog(float x, float y, float z) { //[I-S]LN=105;[I-E]
float worldx = x + mypos.getX(); //[I-S]LN=106;[I-E]
float worldz = z + mypos.getZ(); //[I-S]LN=107;[I-E]
int chunkX = (int) myObject.getGlobalPosition().getX(); //[I-S]LN=108;[I-E]
int chunkZ = (int) myObject.getGlobalPosition().getZ(); //[I-S]LN=109;[I-E]
    if (worldx < chunkX || worldx >= chunkX + tama.width || worldx < chunkZ || worldz >= chunkZ + tama.width) return; //[I-S]LN=110;[I-E]
    int space = 4; //[I-S]LN=111;[I-E]
    if (((int) worldx % space != 0) || ((int) worldz % space != 0)) return; //[I-S]LN=112;[I-E]
    float addspaw = perlin.noise(worldx + tama.seed, worldz + tama.seed); //[I-S]LN=113;[I-E]
    addspaw -= perlin.noise(worldx * 50f + tama.seed, worldz * 50f + tama.seed); //[I-S]LN=114;[I-E]
    if (addspaw >= tama.valuelog && y > tama.waterlevel + tama.heightscale) { //[I-S]LN=115;[I-E]
      int quemspaw = Random.range(0, tama.trees.size() - 1); //[I-S]LN=116;[I-E]
Vector3 positobj = new Vector3(worldx, y + mypos.getY(), worldz).sub(myObject.getGlobalPosition()); //[I-S]LN=117;[I-E]
      SpatialObject log = myObject.instantiate(tama.trees.get((int) quemspaw), positobj); //[I-S]LN=118;[I-E]
      log.setParent(myObject); //[I-S]LN=119;[I-E]
    } //[I-S]LN=120;[I-E]
  } //[I-S]LN=121;[I-E]
 //[I-S]LN=122;[I-E]
  public float getHeight(float x, float z) { //[I-S]LN=123;[I-E]
    long codeKey = CodificKey((int) Math.floor(x), (int) Math.floor(z)); //[I-S]LN=124;[I-E]
    return HeightMap.getOrDefault(codeKey, 0f); //[I-S]LN=125;[I-E]
  } //[I-S]LN=126;[I-E]
 //[I-S]LN=127;[I-E]
  public long CodificKey(int x, int z) { //[I-S]LN=128;[I-E]
    return (((long) x) << 32) | (z & 0xFFFFFFFFL); //[I-S]LN=129;[I-E]
  } //[I-S]LN=130;[I-E]
} //[I-S]LN=131;[I-E]