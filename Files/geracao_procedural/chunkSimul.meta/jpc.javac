class chunkSimul { //[I-S]LN=0;[I-E]
  public int VertecesCount, NormalCount, TrianCount, UvMapCount; //[I-S]LN=1;[I-E]
 //[I-S]LN=2;[I-E]
  public void gerat(int value) { //[I-S]LN=3;[I-E]
    VertecesCount = (value +1) * (value + 1); //[I-S]LN=4;[I-E]
    NormalCount = VertecesCount; //[I-S]LN=5;[I-E]
    UvMapCount = VertecesCount; //[I-S]LN=6;[I-E]
    TrianCount = value * value *6; //[I-S]LN=7;[I-E]
     //[I-S]LN=8;[I-E]
  }  //[I-S]LN=9;[I-E]
} //[I-S]LN=10;[I-E]